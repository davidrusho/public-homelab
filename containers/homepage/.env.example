# ============================================================
# homepage - Environment Variables
# Copy to .env and fill in any widget API keys you want.
# All HOMEPAGE_VAR_* entries are optional - homepage works
# without them, widgets just won't show live service stats.
# ============================================================

# Your timezone - see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Your_Timezone

# --- Service Widget API Keys (all optional) ---

# Plex: Settings > Manage > Devices > find your server > click ... > XML
HOMEPAGE_VAR_PLEX_KEY=your-plex-token

# Sonarr / Radarr / Prowlarr / Bazarr: Settings > General > API Key
HOMEPAGE_VAR_SONARR_KEY=your-sonarr-api-key
HOMEPAGE_VAR_RADARR_KEY=your-radarr-api-key
HOMEPAGE_VAR_PROWLARR_KEY=your-prowlarr-api-key
HOMEPAGE_VAR_BAZARR_KEY=your-bazarr-api-key

# qBittorrent: your WebUI login credentials
HOMEPAGE_VAR_QBITTORRENT_USERNAME=your-qbittorrent-username
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=your-qbittorrent-password

# Kavita: Dashboard > User Settings > API Key
HOMEPAGE_VAR_KAVITA_USERNAME=your-kavita-username
HOMEPAGE_VAR_KAVITA_PASSWORD=your-kavita-password

# Mealie: User Profile > API Tokens > Generate
HOMEPAGE_VAR_MEALIE_KEY=your-mealie-api-key

# Home Assistant: Profile > Long-Lived Access Tokens > Create
HOMEPAGE_VAR_HOMEASSISTANT_KEY=your-homeassistant-long-lived-token

# Tautulli: Settings > Web Interface > API Key
HOMEPAGE_VAR_TAUTULLI_KEY=your-tautulli-api-key

# Overseerr: Settings > General > API Key
HOMEPAGE_VAR_OVERSEERR_KEY=your-overseerr-api-key
