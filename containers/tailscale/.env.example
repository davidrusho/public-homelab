# ============================================================
# tailscale - Environment Variables
# Copy to .env and fill in before first deploy.
# ============================================================

# One-time auth key for registering this node with your Tailscale network.
# Generate at: https://login.tailscale.com/admin/settings/keys
# Settings: reusable=no, expiry=1 day, tags optional
# NOTE: This key is only used once during initial node registration.
# After the node is approved in the admin console, this value is no longer used.
TAILSCALE_AUTHKEY=tskey-auth-your-key-here

# MagicDNS hostname for this node - how it appears in the Tailscale admin console
# and how other Tailscale devices can reach it (e.g. http://docker-host:8080)
TAILSCALE_HOSTNAME=docker-host

# Optional: extra arguments passed to tailscaled
# Example: --advertise-routes=192.168.1.0/24 to expose your LAN to Tailscale
TAILSCALE_EXTRA_ARGS=
