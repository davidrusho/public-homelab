# paperless-ngx/.env.example
# Copy this file to .env and fill in your values before running docker compose up.
# Never commit the .env file — it is gitignored.

# --- PostgreSQL Credentials ---
POSTGRES_USER=paperless                         # Database username
POSTGRES_PASSWORD=your-strong-password-here    # Strong random password
POSTGRES_DB=paperless                          # Database name

# --- Paperless Application ---
# Full public URL where Paperless is accessible
PAPERLESS_URL=https://paperless.yourdomain.com
# Must include your Paperless URL — prevents CSRF errors on login
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless.yourdomain.com

# Timezone string — see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
PAPERLESS_TIME_ZONE=America/New_York

# OCR language code(s) — install additional languages via PAPERLESS_OCR_LANGUAGES
# See: https://tesseract-ocr.github.io/tessdoc/Data-Files-in-different-versions.html
PAPERLESS_OCR_LANGUAGE=eng

# File ownership in volumes — run `id` on your host to find your values
USERMAP_UID=1000
USERMAP_GID=1000

# --- paperless-gpt (AI OCR) ---
# Generate an API token in Paperless: Settings > API Tokens
PAPERLESS_API_TOKEN=your-paperless-api-token-here
# External URL for paperless-gpt to generate correct document links
PAPERLESS_PUBLIC_URL=https://paperless.yourdomain.com
