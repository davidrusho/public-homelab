# jdownloader2/.env.example
# JDownloader 2 has no secrets managed via .env. MyJDownloader credentials (for
# remote access via my.jdownloader.org) are configured through the web UI on first launch.
#
# No .env file is required for this service.
# Update TZ and volume paths directly in compose.yaml.
#
# Web UI: http://your-host:5800
