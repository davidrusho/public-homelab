# frigate/.env.example
# Copy this file to .env and fill in your values before running docker compose up.
# Never commit the .env file — it is gitignored.

# --- Komodo Periphery (optional) ---
# Only required if using the `periphery` service for Komodo-managed deployments.
# Must match the passkey configured in your Komodo core server.
# Generate with: openssl rand -hex 32
KOMODO_PASSKEY=your-komodo-passkey-here

# --- Frigate ---
# Frigate's main configuration (cameras, detectors, recording rules) lives in
# config/config.yml — not in environment variables. See:
# https://docs.frigate.video/configuration/
#
# Any environment variable overrides for Frigate go here.
# Common example:
# FRIGATE_RTSP_PASSWORD=your-camera-rtsp-password
