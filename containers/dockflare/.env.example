# ============================================================
# dockflare - Environment Variables
# Copy to .env and adjust timezone before deploying.
#
# Cloudflare credentials (Account ID, Zone ID, API Token) are
# configured through the dockflare web UI at http://your-host:5001
# after first deploy. They are NOT set here.
# ============================================================

# Your timezone - see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Your_Timezone
