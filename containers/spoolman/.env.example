# spoolman/.env.example
# Spoolman and SpoolmanSync have no secrets managed via .env.
# All configuration (Bambu cloud credentials, printer IP, AMS settings) is done
# through the SpoolmanSync web UI at http://your-host:3003 after first launch.
#
# No .env file is required for this service.
# Update the TZ and volume paths directly in compose.yaml.
