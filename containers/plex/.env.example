# plex/.env.example
# Plex has no secrets managed via .env. Your Plex account is linked during
# first-launch setup via the web UI (http://your-host:32400/web).
#
# No .env file is required for this service.
# Update TZ and volume paths directly in compose.yaml.
#
# Web UI: http://your-host:32400/web
# NOTE: With host networking, Plex binds directly on port 32400 on your host.
