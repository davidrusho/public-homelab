# gluetun-downloads/.env.example
# Copy this file to .env and fill in your values before running docker compose up.
# Never commit the .env file — it is gitignored.

# --- VPN Credentials (Private Internet Access) ---
# Your VPN provider login credentials.
# For other providers, see: https://github.com/qdm12/gluetun/wiki
OPENVPN_USER=your-vpn-username
OPENVPN_PASSWORD=your-vpn-password
