# vikunja/.env.example
# Copy this file to .env and fill in your values before running docker compose up.
# Never commit the .env file — it is gitignored.

# --- PostgreSQL Credentials ---
POSTGRES_USER=vikunja                           # Database username (can be any string)
POSTGRES_PASSWORD=your-strong-password-here     # Strong random password for the database
POSTGRES_DB=vikunja                             # Database name

# --- Vikunja Application ---
# Full public URL where Vikunja is accessible (include trailing slash if required)
# Used for share links, email notifications, and OAuth redirect URIs
VIKUNJA_SERVICE_PUBLICURL=https://vikunja.yourdomain.com

# Secret key used to sign JWT tokens — generate with: openssl rand -hex 32
VIKUNJA_JWT_SECRET=your-random-64-char-secret-here

# Set to "true" to allow anyone to create an account, "false" for private instances
VIKUNJA_SERVICE_ENABLEREGISTRATION=false
