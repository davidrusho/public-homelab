# karakeep/.env.example
# Copy this file to .env and fill in your values before running docker compose up.
# Never commit the .env file — it is gitignored.

# --- Meilisearch ---
# IMPORTANT: This key must be identical in both the web and meilisearch services.
# Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=your-meilisearch-master-key-here

# --- Karakeep Application ---
# Secret for NextAuth session signing — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your-nextauth-secret-here
