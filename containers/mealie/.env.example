# mealie/.env.example
# Copy this file to .env and fill in your values before running docker compose up.
# Never commit the .env file — it is gitignored.

# --- PostgreSQL Credentials ---
POSTGRES_USER=mealie                            # Database username
POSTGRES_PASSWORD=your-strong-password-here    # Strong random password for the database
POSTGRES_PORT=5432                             # Default PostgreSQL port
POSTGRES_DB=mealie                             # Database name

# --- Google OAuth / OIDC ---
# Create credentials at: https://console.cloud.google.com/ > APIs & Services > Credentials
# Set the authorized redirect URI to: https://mealie.yourdomain.com/api/auth/callback/oidc
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_SECRET=your-google-oauth-client-secret
