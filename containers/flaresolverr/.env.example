# flaresolverr/.env.example
# FlareSolverr has no required secrets. The optional variables below have defaults
# already set in compose.yaml via the ${VAR:-default} syntax, so this file is
# only needed if you want to override them.
#
# Optional overrides:
LOG_LEVEL=info     # Logging verbosity: info or debug
LOG_HTML=false     # Log full HTML responses: true or false
CAPTCHA_SOLVER=none # Captcha solver: none (default) — see FlareSolverr docs for options
