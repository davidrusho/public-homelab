# home-automation/.env.example
# Copy this file to .env and fill in your values before running docker compose up.
# Never commit the .env file — it is gitignored.

# --- Timezone ---
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# --- Govee2MQTT ---
# Govee developer API key — request at: https://developer.govee.com/
GOVEE_API_KEY=your-govee-api-key-here

# Govee account credentials (same as the Govee Home app login)
GOVEE_EMAIL=your-govee-account-email@example.com
GOVEE_PASSWORD=your-govee-account-password

# MQTT broker connection — with host networking, Mosquitto is on localhost
GOVEE_MQTT_HOST=127.0.0.1
GOVEE_MQTT_PORT=1883
GOVEE_MQTT_TLS=false

# Display temperature in Celsius (C) or Fahrenheit (F)
GOVEE_TEMPERATURE_SCALE=F

# MQTT broker address used internally by govee2mqtt
MQTT_BROKER=127.0.0.1

# Log output style: auto (colored if TTY) or never (plain text)
RUST_LOG_STYLE=auto
