# zipline/.env.example
# Copy this file to .env and fill in your values before running docker compose up.
# Never commit the .env file — it is gitignored.

# --- PostgreSQL ---
POSTGRESQL_PASSWORD=your-strong-password-here  # Strong random password for the database

# --- Zipline Application ---
# IMPORTANT: Must be at least 32 characters
# Generate with: openssl rand -hex 32
ZIPLINE_CORE_SECRET=your-random-secret-at-least-32-chars-here
