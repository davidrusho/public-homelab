# arr-stack/.env.example
# The *arr suite has no secrets managed via .env. All configuration (API keys,
# indexer connections, download client settings) is done through each app's web UI
# after first launch.
#
# No .env file is required for this stack.
# Update TZ, PUID, PGID, and volume paths directly in compose.yaml.
#
# Default web UI ports:
#   Prowlarr:     http://your-host:9696
#   Sonarr 1080:  http://your-host:8990
#   Sonarr Anime: http://your-host:8991
#   Radarr:       http://your-host:7878
#   Bazarr:       http://your-host:6767
